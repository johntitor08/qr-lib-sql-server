# SQL Server bağlantısı
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=Bibliotheca
DB_USER=sa
DB_PASSWORD=YourStrongPassword!

# Şifreleme
# Azure SQL → DB_ENCRYPT=true, DB_TRUST_CERT=false
# Yerel/self-signed → DB_ENCRYPT=false, DB_TRUST_CERT=true
DB_ENCRYPT=false
DB_TRUST_CERT=true

# JWT — en az 32 karakter, rastgele bir değer girin
JWT_SECRET=change-me-to-a-random-secret-minimum-32-chars

# Admin hesabı (kayıt sırasında otomatik onaylanır)
# index.html içindeki ADMIN_EMAIL sabitiyle aynı olmalı
ADMIN_EMAIL=admin@yourdomain.com

# CORS — virgülle ayrılmış izin verilen origin'ler
# Frontend artık API ile aynı porttan sunulduğu için aynı-origin isteklerde
# CORS devreye girmez. Yine de farklı bir origin'den erişeceksen buraya ekle.
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Sunucu — uzak sunucuda yayın portu
PORT=3002
NODE_ENV=production
